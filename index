<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Test Qualità Codice a Barre</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%; height: 100%;
      background: #111;
      color: #eee;
      font-family: system-ui, -apple-system, sans-serif;
      overflow: hidden;
    }
    #wrap {
      position: relative;
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    video, canvas {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    video { z-index: 1; }
    #overlay {
      position: absolute;
      z-index: 2;
      pointer-events: none;
    }
    #status {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      padding: 10px 22px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.3px;
      background: rgba(0,0,0,0.72);
      backdrop-filter: blur(6px);
      white-space: nowrap;
      transition: color 0.15s, border-color 0.15s;
    }
    #hint {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      font-size: 13px;
      opacity: 0.7;
      background: rgba(0,0,0,0.55);
      padding: 6px 14px;
      border-radius: 6px;
    }
    .err {
      position: absolute;
      z-index: 10;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      padding: 20px;
      max-width: 90%;
    }
  </style>
</head>
<body>
  <div id="wrap">
    <video id="video" playsinline muted autoplay></video>
    <canvas id="overlay"></canvas>
    <div id="hint">Inquadra il codice a barre nel riquadro</div>
    <div id="status">In attesa…</div>
  </div>

  <script>
    const video = document.getElementById('video');
    const overlay = document.getElementById('overlay');
    const ctx = overlay.getContext('2d', { willReadFrequently: true });
    const statusEl = document.getElementById('status');

    // Dimensioni del riquadro di analisi (percentuale del lato corto)
    const ROI_RATIO = 0.62;
    const SCAN_LINES = 9;          // numero di linee di scansione orizzontali
    const MIN_BARS = 18;           // minimo numero di barre/spazi attesi
    const EDGE_THRESHOLD = 28;     // soglia minima di salto di intensità

    let stream = null;
    let animId = null;
    let lastQuality = 'none';

    async function startCamera() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: { ideal: 'environment' },
            width: { ideal: 1280 },
            height: { ideal: 720 }
          },
          audio: false
        });
        video.srcObject = stream;
        await video.play();
        resize();
        loop();
      } catch (e) {
        document.getElementById('wrap').innerHTML =
          `<div class="err"><p>Impossibile accedere alla fotocamera.</p>
           <p style="margin-top:12px;font-size:13px;opacity:.7">${e.message}</p></div>`;
      }
    }

    function resize() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      overlay.width = w;
      overlay.height = h;
    }
    window.addEventListener('resize', resize);

    function getROI() {
      const w = overlay.width;
      const h = overlay.height;
      const side = Math.min(w, h) * ROI_RATIO;
      const x = (w - side) / 2;
      const y = (h - side) / 2;
      return { x, y, side };
    }

    // Analizza una singola riga di pixel (grayscale) e restituisce metriche
    function analyzeScanline(data, width, y, roiX, roiSide) {
      const startX = Math.floor(roiX);
      const endX = Math.floor(roiX + roiSide);
      const len = endX - startX;
      if (len < 40) return null;

      // Estrai intensità (media RGB → gray)
      const gray = new Float32Array(len);
      for (let i = 0; i < len; i++) {
        const idx = ((y * width) + (startX + i)) * 4;
        gray[i] = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
      }

      // Contrasto globale
      let minG = 255, maxG = 0;
      for (let i = 0; i < len; i++) {
        if (gray[i] < minG) minG = gray[i];
        if (gray[i] > maxG) maxG = gray[i];
      }
      const contrast = maxG - minG;
      if (contrast < 25) return { score: 0, reason: 'contrasto troppo basso' };

      // Normalizza e trova i bordi (transizioni)
      const mid = (minG + maxG) / 2;
      const edges = [];
      let prev = gray[0] > mid ? 1 : 0;
      for (let i = 1; i < len; i++) {
        const curr = gray[i] > mid ? 1 : 0;
        if (curr !== prev) {
          // forza del bordo
          const force = Math.abs(gray[i] - gray[i - 1]);
          edges.push({ pos: i, force, from: prev });
          prev = curr;
        }
      }

      if (edges.length < MIN_BARS) {
        return { score: 0.15, reason: 'poche barre rilevate' };
      }

      // Ampiezze delle barre/spazi
      const widths = [];
      let last = 0;
      for (const e of edges) {
        widths.push(e.pos - last);
        last = e.pos;
      }
      widths.push(len - last);

      // Filtra le quiet-zone (prime e ultime zone molto larghe)
      const body = widths.slice(1, -1);
      if (body.length < 10) return { score: 0.2, reason: 'struttura incompleta' };

      // Media e deviazione delle ampiezze (regolarità)
      const mean = body.reduce((a, b) => a + b, 0) / body.length;
      let variance = 0;
      for (const w of body) variance += (w - mean) ** 2;
      variance /= body.length;
      const cv = Math.sqrt(variance) / mean; // coefficiente di variazione

      // Nitidezza media dei bordi
      const avgForce = edges.reduce((a, e) => a + e.force, 0) / edges.length;
      const sharpness = Math.min(1, avgForce / 90);

      // Quiet zone (deve essere presente e abbastanza larga)
      const quietLeft = widths[0] / mean;
      const quietRight = widths[widths.length - 1] / mean;
      const quietOk = quietLeft > 2.2 && quietRight > 2.2;

      // Punteggio composito 0-1
      let score = 0;
      // Contrasto (0-0.25)
      score += Math.min(0.25, contrast / 180);
      // Nitidezza (0-0.30)
      score += sharpness * 0.30;
      // Regolarità (0-0.30) – cv basso è meglio
      score += Math.max(0, 0.30 * (1 - cv * 1.8));
      // Numero di elementi (0-0.10)
      score += Math.min(0.10, (edges.length - 15) / 80);
      // Quiet zone
      if (quietOk) score += 0.05;

      score = Math.max(0, Math.min(1, score));
      return { score, contrast, sharpness, cv, edges: edges.length, quietOk };
    }

    function evaluateFrame() {
      const w = overlay.width;
      const h = overlay.height;
      if (w === 0 || h === 0) return null;

      // Disegna il frame video sul canvas (nascosto) per leggerne i pixel
      ctx.drawImage(video, 0, 0, w, h);
      const imageData = ctx.getImageData(0, 0, w, h);
      const data = imageData.data;

      const roi = getROI();
      const scores = [];
      const step = roi.side / (SCAN_LINES + 1);

      for (let i = 1; i <= SCAN_LINES; i++) {
        const y = Math.floor(roi.y + step * i);
        const res = analyzeScanline(data, w, y, roi.x, roi.side);
        if (res) scores.push(res.score);
      }

      if (scores.length === 0) return { quality: 'none', score: 0 };

      // Media dei migliori 60% delle linee (ignora outlier)
      scores.sort((a, b) => b - a);
      const keep = Math.max(2, Math.ceil(scores.length * 0.6));
      const avg = scores.slice(0, keep).reduce((a, b) => a + b, 0) / keep;

      let quality;
      if (avg >= 0.62) quality = 'good';
      else if (avg >= 0.32) quality = 'disturbed';
      else quality = 'bad';

      return { quality, score: avg };
    }

    function drawOverlay(result) {
      const w = overlay.width;
      const h = overlay.height;
      const roi = getROI();

      // Pulisci solo la parte disegnata (il video è già sotto)
      ctx.clearRect(0, 0, w, h);

      // Riquadro
      let color = '#555';
      let label = 'In attesa…';
      if (result) {
        if (result.quality === 'good') {
          color = '#22c55e';
          label = 'Eccellente / Buono';
        } else if (result.quality === 'disturbed') {
          color = '#f59e0b';
          label = 'Disturbato';
        } else if (result.quality === 'bad') {
          color = '#ef4444';
          label = 'Non leggibile';
        }
      }

      // Ombra esterna leggera
      ctx.fillStyle = 'rgba(0,0,0,0.35)';
      ctx.fillRect(0, 0, w, roi.y);
      ctx.fillRect(0, roi.y + roi.side, w, h - (roi.y + roi.side));
      ctx.fillRect(0, roi.y, roi.x, roi.side);
      ctx.fillRect(roi.x + roi.side, roi.y, w - (roi.x + roi.side), roi.side);

      // Bordo del riquadro
      ctx.strokeStyle = color;
      ctx.lineWidth = 3;
      ctx.strokeRect(roi.x + 1.5, roi.y + 1.5, roi.side - 3, roi.side - 3);

      // Angoli più spessi
      const c = 18;
      ctx.lineWidth = 5;
      ctx.beginPath();
      // TL
      ctx.moveTo(roi.x, roi.y + c); ctx.lineTo(roi.x, roi.y); ctx.lineTo(roi.x + c, roi.y);
      // TR
      ctx.moveTo(roi.x + roi.side - c, roi.y); ctx.lineTo(roi.x + roi.side, roi.y); ctx.lineTo(roi.x + roi.side, roi.y + c);
      // BL
      ctx.moveTo(roi.x, roi.y + roi.side - c); ctx.lineTo(roi.x, roi.y + roi.side); ctx.lineTo(roi.x + c, roi.y + roi.side);
      // BR
      ctx.moveTo(roi.x + roi.side - c, roi.y + roi.side); ctx.lineTo(roi.x + roi.side, roi.y + roi.side); ctx.lineTo(roi.x + roi.side, roi.y + roi.side - c);
      ctx.stroke();

      // Aggiorna testo
      statusEl.textContent = label;
      statusEl.style.color = color;
      statusEl.style.border = `1px solid ${color}`;
    }

    let frameCount = 0;
    function loop() {
      animId = requestAnimationFrame(loop);
      frameCount++;
      // Analizza ogni 2 frame per bilanciare fluidità e carico
      if (frameCount % 2 === 0) {
        const result = evaluateFrame();
        drawOverlay(result);
      } else {
        // Ridisegna solo il riquadro con l’ultimo colore
        drawOverlay(lastResult);
      }
    }

    let lastResult = null;
    // Override drawOverlay per tenere memoria
    const originalDraw = drawOverlay;
    drawOverlay = function(result) {
      if (result) lastResult = result;
      originalDraw(result || lastResult);
    };

    // Avvio
    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
      startCamera();
    } else {
      document.getElementById('wrap').innerHTML =
        '<div class="err">Il browser non supporta l’accesso alla fotocamera.</div>';
    }

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (animId) cancelAnimationFrame(animId);
      if (stream) stream.getTracks().forEach(t => t.stop());
    });
  </script>
</body>
</html>
